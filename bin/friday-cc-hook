#!/usr/bin/python3 -IS
"""Claude Code hook: append the event to ~/.friday/state/claude-events.jsonl for fridayd.

Installed as an async command hook, so it never blocks a session. Runs under the system Python
(3.9 on macOS), stdlib only. One os.write() per event keeps concurrent appends from interleaving.
Always exits 0: a broken Friday must never disturb a Claude Code session.
"""
import json
import os
import sys
import time

KEEP = ("hook_event_name", "session_id", "transcript_path", "cwd", "notification_type", "message",
        "title", "tool_name", "error", "error_type", "stop_hook_active", "permission_mode", "source", "reason")


def clip(value, n=2000):
    if isinstance(value, str) and len(value) > n:
        return value[:n] + "…"
    return value


def main():
    if __import__("os").environ.get("FRIDAY_INTERNAL"):   # Friday's own headless claude (claude_ask): not his session
        return
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    event = {k: clip(payload[k]) for k in KEEP if k in payload}
    if payload.get("tool_name") == "AskUserQuestion":
        questions = (payload.get("tool_input") or {}).get("questions") or []
        event["questions"] = [clip(q.get("question", ""), 400) for q in questions if isinstance(q, dict)]
    if "last_assistant_message" in payload:
        event["last_assistant_message"] = clip(payload["last_assistant_message"], 3000)
    event["ts"] = time.time()
    home = os.environ.get("FRIDAY_HOME") or os.path.expanduser("~/.friday")
    state = os.path.join(home, "state")
    os.makedirs(state, exist_ok=True)
    line = (json.dumps(event, ensure_ascii=False) + "\n").encode("utf-8")
    fd = os.open(os.path.join(state, "claude-events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
