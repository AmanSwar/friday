{
  "manifest_version": 3,
  "name": "Friday",
  "version": "2.2.0",
  "description": "Lets Friday, Aman's local assistant, see the tabs he pins it to (a 'Friday' tab group) and open pages there. Talks only to 127.0.0.1.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Friday"
  },
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Pin Friday to this tab (or unpin it)"
    }
  }
}
